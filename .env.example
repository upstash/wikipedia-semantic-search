UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=

QSTASH_TOKEN=

# LLM Provider: "openai" (default) or "minimax"
LLM_PROVIDER=openai

# OpenAI — required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# MiniMax — required when LLM_PROVIDER=minimax
# Get your API key at https://api.minimax.io
MINIMAX_API_KEY=
# Model options: MiniMax-M2.7 (default), MiniMax-M2.7-highspeed,
#                MiniMax-M2.5, MiniMax-M2.5-highspeed (all 204K context)
MINIMAX_MODEL=MiniMax-M2.7
